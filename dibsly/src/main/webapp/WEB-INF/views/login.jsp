<%@ page contentType="text/html;charset=UTF-8" %><% request.setAttribute("pageTitle", "Log in · Dibsly"); %><%@ include file="header.jspf" %>
<main id="main" class="container auth-layout"><section class="auth-story"><h1>Back for<br> your next<br> <em>big thing.</em></h1><p>Your projects, your pitches, and the people who make them happen.</p><div class="auth-quote"><span class="brand">dibsly.</span><p>Your gig. Their pitch. Your pick.</p></div></section><section class="auth-form"><h2>Good to see you.</h2><p class="lede">Log in to your workspace.</p>
<% if(request.getAttribute("error")!=null){ %><div class="alert error" role="alert"><%=e(request.getAttribute("error"))%></div><% } %>
<% if(request.getAttribute("flashMessage")!=null){ %><div class="alert success" role="status"><%=e(request.getAttribute("flashMessage"))%></div><% } %>
<form method="post" action="<%=base%>/login"><input type="hidden" name="csrf" value="<%=e(token)%>"><div class="field"><label for="username">Username</label><input id="username" name="username" autocomplete="username" required maxlength="32" value="<%=val(request,"username")%>" autofocus></div><div class="field"><label for="password">Password</label><div class="password-field"><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="128"><button class="text-button" type="button" data-password="password" aria-label="Show password">Show</button></div></div><button class="full" type="submit">Log in <%=arrow()%></button></form><p class="auth-footer">New here? <a href="<%=base%>/register">Find your people</a></p>
<% if(DemoData.enabled()){ %><details class="demo-accounts" open><summary>Try Dibsly with a demo account</summary><p>Use password <code>DibslyDemo2026!</code></p><dl><div><dt>Client</dt><dd><code>client.demo</code></dd></div><div><dt>Freelancer</dt><dd><code>freelancer.demo</code></dd></div><div><dt>Another freelancer</dt><dd><code>designer.demo</code></dd></div></dl><p class="quiet">Use separate browsers or a private window to demonstrate different users together. Admin credentials are configured by the person running this demo.</p></details><% } %></section></main><%@ include file="footer.jspf" %>
