<%@ page contentType="text/html;charset=UTF-8" %><% request.setAttribute("pageTitle", "Join the collaboration · Dibsly"); %><%@ include file="header.jspf" %>
<main id="main" class="container auth-layout"><section class="auth-story"><h1>Great work.<br> Starts with<br> <em>your people.</em></h1><p>Bring the idea or bring the talent. There's a place for you here.</p><div class="auth-quote"><span class="brand">dibsly.</span><p>A more thoughtful way to work together.</p></div></section><section class="auth-form"><h2>Let's make something.</h2><p class="lede">Create your Dibsly account.</p><% if(request.getAttribute("error")!=null){ %><div class="alert error" role="alert"><%=e(request.getAttribute("error"))%></div><% } %>
<form method="post" action="<%=base%>/register"><input type="hidden" name="csrf" value="<%=e(token)%>"><fieldset class="role-choice"><legend>What brings you here?</legend><label><input type="radio" name="role" value="CUSTOMER" <%=!"PROVIDER".equals(request.getParameter("role"))?"checked":""%>><span><strong>I want to hire</strong><small>Post projects & choose talent</small></span></label><label><input type="radio" name="role" value="PROVIDER" <%= "PROVIDER".equals(request.getParameter("role"))?"checked":""%>><span><strong>I want to freelance</strong><small>Find projects & send pitches</small></span></label></fieldset><div class="field"><label for="displayName">Your name or studio name</label><input id="displayName" name="displayName" autocomplete="name" required minlength="2" maxlength="100" value="<%=val(request,"displayName")%>"></div><div class="field"><label for="username">Choose a username</label><input id="username" name="username" autocomplete="username" required minlength="3" maxlength="32" pattern="[A-Za-z0-9._\-]{3,32}" value="<%=val(request,"username")%>" aria-describedby="username-hint"><p class="hint" id="username-hint">3–32 letters, numbers, dots, hyphens, or underscores.</p></div><div class="field"><label for="password">Create a password</label><div class="password-field"><input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required aria-describedby="password-hint"><button type="button" class="text-button" data-password="password" aria-label="Show password">Show</button></div><p class="hint" id="password-hint">12–128 characters, with uppercase, lowercase, a number, and a symbol. Keep it somewhere safe; account recovery isn't available in this release.</p></div><p class="hint signup-privacy">Read our <a href="<%=base%>/privacy">Privacy Policy</a> to understand how your account and project information is used.</p><button class="full" type="submit">Create my account <%=arrow()%></button></form><p class="auth-footer">Already part of Dibsly? <a href="<%=base%>/login">Log in</a></p></section></main><%@ include file="footer.jspf" %>
