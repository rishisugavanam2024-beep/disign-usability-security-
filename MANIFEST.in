include README.md PACKAGE_README.md pyproject.toml
include LICENSE CHANGELOG.md
include app.py Dockerfile compose.yaml requirements.txt requirements-django.txt requirements-integrations.txt
recursive-include saferevoke *.py
recursive-include docs *.md
recursive-include examples *.py *.json *.sql *.java *.mjs
recursive-include scripts *.py
prune reports
prune examples/flask_pytest/reports
recursive-include tests *.py
recursive-include templates *.html
recursive-include static *.js *.css
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .env .env.* .pypirc *.class
